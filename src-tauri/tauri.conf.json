{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SipUp",
  "version": "0.1.0",
  "identifier": "com.adrianniel.sipup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "url": "index.html",
        "title": "SipUp",
        "width": 92,
        "height": 118,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "SipUp",
        "width": 440,
        "height": 720,
        "minWidth": 380,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Floating water reminder",
    "longDescription": "SipUp floats on your screen and reminds you to drink water while you work or study, so you reach your daily goal of glasses.",
    "category": "HealthcareAndFitness"
  }
}